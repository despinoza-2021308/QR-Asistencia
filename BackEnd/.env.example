# Configuración del Servidor Express
PORT=4000
# En producción/Vercel colocar la URL pública (ej: https://tu-proyecto.vercel.app)
FRONTEND_URL=http://localhost:5173

# Secreto criptográfico obligatorio para firma de JWT (mínimo 32 caracteres)
# Generar uno nuevo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_secreto_super_seguro_para_jwt_aqui_minimo_32_caracteres
JWT_EXPIRES_IN=2h

# Conexión a Base de Datos PostgreSQL (Cloud / Supabase con SSL)
DATABASE_URL=postgresql://usuario:password@host:6543/postgres

# Conexión Local de Respaldo (solo para desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_local
DB_NAME=postgres

# Credenciales de Administrador
ADMIN_USER=admin
# Puedes usar la contraseña en texto plano:
ADMIN_PASSWORD=CambiarEstaPasswordSegura2026!
# O preferiblemente el hash criptográfico seguro (generar con: node hash-password.js <tu_password>):
# ADMIN_PASSWORD_HASH=scrypt$salthex$derivedkeyhex

